    {
      "id": "hadith:bukhari:6464",
      "kind": "hadith",
      "ref": "Sahih al-Bukhari 6464",
      "themes": [
        "prayer"
      ],
      "source": "https://sunnah.com/bukhari:6464",
      "grade": "Sahih",
      "arabicExcerpt": "وَأَنَّ أَحَبَّ الأَعْمَالِ أَدْوَمُهَا إِلَى اللَّهِ، وَإِنْ قَلَّ",
      "enSummary": "Choose sincere actions you can maintain. Consistent good deeds, even small ones, are beloved to Allah.",
      "urSummary": "نیک کام اخلاص کے ساتھ مستقل کریں۔ اللہ کو مسلسل نیک اعمال پسند ہیں، چاہے وہ تھوڑے ہوں۔"
    },
    {
      "id": "hadith:muslim:2747a",
      "kind": "hadith",
      "ref": "Sahih Muslim 2747a",
      "themes": [
        "hope",
        "forgiveness"
      ],
      "source": "https://sunnah.com/muslim:2747a",
      "grade": "Sahih",
      "arabicExcerpt": "لَلَّهُ أَشَدُّ فَرَحًا بِتَوْبَةِ عَبْدِهِ حِينَ يَتُوبُ إِلَيْهِ",
      "enSummary": "Allah welcomes His servant’s sincere repentance with great joy. Turn back to Him with hope.",
      "urSummary": "بندہ سچی توبہ کرکے اللہ کی طرف لوٹتا ہے تو اللہ بہت خوش ہوتا ہے۔ امید کے ساتھ اس کی طرف رجوع کریں۔"
    },
    {
      "id": "hadith:muslim:2754",
      "kind": "hadith",
      "ref": "Sahih Muslim 2754",
      "themes": [
        "hope"
      ],
      "source": "https://sunnah.com/muslim:2754",
      "grade": "Sahih",
      "arabicExcerpt": "لَلَّهُ أَرْحَمُ بِعِبَادِهِ مِنْ هَذِهِ بِوَلَدِهَا",
      "enSummary": "Allah’s mercy towards His servants exceeds a mother’s compassion for her child.",
      "urSummary": "اللہ اپنے بندوں پر ایک ماں کی اپنے بچے پر شفقت سے بھی زیادہ رحم کرنے والا ہے۔"
    },
    {
      "id": "hadith:bukhari:527",
      "kind": "hadith",
      "ref": "Sahih al-Bukhari 527",
      "themes": [
        "prayer"
      ],
      "source": "https://sunnah.com/bukhari:527",
      "grade": "Sahih",
      "arabicExcerpt": "الصَّلاَةُ عَلَى وَقْتِهَا",
      "enSummary": "The Prophet named prayer at its appointed time among the deeds most beloved to Allah.",
      "urSummary": "نبی کریم ﷺ نے وقت پر نماز ادا کرنے کو اللہ کے محبوب ترین اعمال میں شمار فرمایا۔"
    }
  ]
